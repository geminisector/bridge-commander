HOST=127.0.0.1
PORT=8787
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
ADMIN_TOKEN=replace-with-a-long-random-token
ADMIN_ORIGINS=http://localhost:8788

# Optional overrides. Unset values use the packaged activity and image trees.
# ACTIVITY_DIST=/path/to/activity/dist
# ASSET_DIR=/path/to/img

# Voice: the Jitsi Meet domain the player page embeds so a crew can talk. Unset
# uses the public meet.jit.si. Set it empty (JITSI_DOMAIN=) to hide the voice
# tab entirely. The mic needs a secure context, so players on a LAN must reach
# the app over https (localhost counts) or the browser blocks the microphone.
# JITSI_DOMAIN=meet.jit.si

# Flavors (settings / mods). Unset uses the packaged bridge/flavors tree and the
# core setting. One mod is loaded at a time; DEFAULT_FLAVOR loads that setting at
# boot when the console has not loaded one. Other mods are loaded from the GM
# console, and loading one unloads every other.
# FLAVORS_DIR=/path/to/flavors
# DEFAULT_FLAVOR=core
