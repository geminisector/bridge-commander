HOST=127.0.0.1
PORT=8787
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
ADMIN_TOKEN=replace-with-a-long-random-token
ADMIN_ORIGINS=http://localhost:8788

# Optional overrides. Unset values use the packaged activity and image trees.
# ACTIVITY_DIST=/path/to/activity/dist
# ASSET_DIR=/path/to/img

# Flavors (settings / mods). Unset uses the packaged bridge/flavors tree and the
# core setting. DEFAULT_FLAVOR picks the setting new rooms start on and counts as
# an explicit activation; other mods are activated from the GM console.
# FLAVORS_DIR=/path/to/flavors
# DEFAULT_FLAVOR=core
